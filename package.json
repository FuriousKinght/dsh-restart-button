{
  "name": "dsh-restart-button",
  "version": "1.0.0",
  "description": "Adds a button at the foot of the sidebar that restarts the DSH desktop app and reloads the page when it comes back.",
  "license": "MIT",
  "type": "module",
  "main": "entry.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FuriousKinght/dsh-restart-button.git"
  },
  "homepage": "https://github.com/FuriousKinght/dsh-restart-button#readme",
  "bugs": {
    "url": "https://github.com/FuriousKinght/dsh-restart-button/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "relaunch",
    "sidebar",
    "windows"
  ],
  "exports": {
    ".": "./entry.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "entry.js",
    "build-client.mjs",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
